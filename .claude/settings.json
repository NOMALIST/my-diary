{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/pre-commit.mjs\"",
            "timeout": 600,
            "statusMessage": "pre-commit: lint → build → test 실행 중"
          }
        ]
      }
    ]
  }
}
